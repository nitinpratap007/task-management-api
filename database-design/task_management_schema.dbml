// ============================================================================
// task_management_schema.dbml
// DBML for https://dbdiagram.io/
// ============================================================================

Table users {
  id bigserial [pk, increment]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  is_verified boolean [not null, default: false]
  verification_token_hash text
  verification_token_expiry timestamptz
  reset_token_hash text
  reset_token_expiry timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    email [unique, name: "users_email_unique"]
  }
}

Table projects {
  id bigserial [pk, increment]
  owner_id bigint [not null, ref: > users.id]
  name varchar(150) [not null]
  description text [not null, default: '']
  status varchar(20) [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    owner_id [name: "idx_projects_owner_id"]
    status [name: "idx_projects_status"]
  }
}

Table project_members {
  project_id bigint [not null, ref: > projects.id]
  user_id bigint [not null, ref: > users.id]
  role varchar(20) [not null, default: 'member']
  joined_at timestamptz [not null, default: `now()`]

  Indexes {
    (project_id, user_id) [pk]
    user_id [name: "idx_project_members_user_id"]
  }
}

Table tasks {
  id bigserial [pk, increment]
  user_id bigint [not null, ref: > users.id]
  project_id bigint [ref: > projects.id]
  title varchar(255) [not null]
  description text [not null, default: '']
  completed boolean [not null, default: false]
  priority varchar(10) [not null, default: 'medium']
  due_date timestamptz
  reminder_sent boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "idx_tasks_user_id"]
    project_id [name: "idx_tasks_project_id"]
    completed [name: "idx_tasks_completed"]
    due_date [name: "idx_tasks_due_date"]
    (user_id, completed) [name: "idx_tasks_user_completed"]
    (id, project_id) [unique, name: "uq_tasks_id_project"]
  }
}

Table task_assignees {
  task_id bigint [not null, ref: > tasks.id]
  user_id bigint [not null, ref: > users.id]
  assigned_at timestamptz [not null, default: `now()`]

  Indexes {
    (task_id, user_id) [pk]
    user_id [name: "idx_task_assignees_user_id"]
  }
}

Table comments {
  id bigserial [pk, increment]
  task_id bigint [not null, ref: > tasks.id]
  user_id bigint [not null, ref: > users.id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    task_id [name: "idx_comments_task_id"]
    user_id [name: "idx_comments_user_id"]
  }
}

Table labels {
  id bigserial [pk, increment]
  project_id bigint [not null, ref: > projects.id]
  name varchar(50) [not null]
  color varchar(7) [not null, default: '#3B82F6']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (project_id, name) [unique, name: "uq_labels_project_name"]
    (id, project_id) [unique, name: "uq_labels_id_project"]
    project_id [name: "idx_labels_project_id"]
  }
}

Table task_labels {
  task_id bigint [not null]
  label_id bigint [not null]
  project_id bigint [not null, ref: > projects.id]
  assigned_at timestamptz [not null, default: `now()`]

  Indexes {
    (task_id, label_id) [pk]
    label_id [name: "idx_task_labels_label_id"]
    project_id [name: "idx_task_labels_project_id"]
  }
}

// Composite foreign keys: a task and its label must belong to the same project
Ref: task_labels.(task_id, project_id) > tasks.(id, project_id)
Ref: task_labels.(label_id, project_id) > labels.(id, project_id)
