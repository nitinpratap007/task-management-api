            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Login returns JWT\", function () { var d = pm.response.json(); pm.expect(d.success).to.eql(true); pm.expect(d.data.token).to.not.be.undefined; });",
                  "pm.test(\"Save token\", function () { var d = pm.response.json(); if (d.data && d.data.token) { pm.environment.set(\"token\", d.data.token); } });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /me (Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
