{
  "info": {
    "name": "Task Management REST API — WA-5",
    "description": "Postman collection for the Task Management REST API with Email Verification and Password Reset (WA-5).\n\nTest sequence: Health → Register → Login (unverified, expect 403) → Verify Email → Login (verified) → /me → Forgot Password → Reset Password → Login (old pass, expect 401) → Login (new pass) → Task CRUD → Protected routes (401 tests).\n\nSet environment variables: baseUrl, token, taskId, verificationToken, resetToken",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response has status ok\", function () { var d = pm.response.json(); pm.expect(d.status).to.eql(\"ok\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Account created (unverified)\", function () { var d = pm.response.json(); pm.expect(d.success).to.eql(true); pm.expect(d.data.user.isVerified).to.eql(false); pm.expect(d.data.token).to.be.undefined; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Login (Before Verification - expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Unverified login rejected\", function () { var d = pm.response.json(); pm.expect(d.success).to.eql(false); pm.expect(d.message).to.include(\"verify\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-email"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Email verified\", function () { var d = pm.response.json(); pm.expect(d.success).to.eql(true); pm.expect(d.message).to.include(\"verified\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Verify Email (query param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-email?token={{verificationToken}}", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-email"], "query": [{ "key": "token", "value": "{{verificationToken}}" }] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 or 400\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
