          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns user info\", function () { var d = pm.response.json(); pm.expect(d.success).to.eql(true); pm.expect(d.data.user).to.not.be.undefined; pm.expect(d.data.user.password_hash).to.be.undefined; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
