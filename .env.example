PORT=3000
JWT_SECRET=put_your_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require
# Optional: comma-separated list of allowed CORS origins (e.g. http://localhost:5173)
# ALLOWED_ORIGINS=http://localhost:5173

# Email configuration (for verification and password reset)
# Use Mailtrap (https://mailtrap.io) or another SMTP test service for local testing
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=your_mailtrap_username
# EMAIL_PASS=your_mailtrap_password
# EMAIL_FROM=noreply@taskmanagement.com
# APP_BASE_URL=http://localhost:3000